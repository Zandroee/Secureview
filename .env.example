APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CATALOG_STORAGE_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional absolute path for public catalog uploads when the web root is separate from the Laravel app.
# PUBLIC_STORAGE_PATH=

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

PAYMONGO_BASE_URL=https://api.paymongo.com

# Optional free-tier Gemini API for the customer support chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

VITE_APP_NAME="${APP_NAME}"

# Optional; the Leaflet/OpenStreetMap service map does not require a Google Maps key.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional business profile for the SecureView printable order invoice preview.
# These values do not register the invoice with BIR or establish tax compliance.
INVOICE_BUSINESS_NAME="SecureView"
INVOICE_REGISTERED_NAME=
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_EMAIL=
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_TIN=
# Allowed values: vat, non_vat, not_configured
INVOICE_VAT_STATUS=not_configured
INVOICE_BRANCH_CODE=
INVOICE_BIR_PERMIT_NUMBER=
INVOICE_BIR_ATP_NUMBER=
INVOICE_SERIAL_NUMBER_RANGE=
INVOICE_PTI_EINVOICE_NUMBER=
INVOICE_EIS_CERTIFICATION_REFERENCE=

# Service booking priority fees in PHP (proposed defaults; confirm before production use).
# Each surcharge is charged once per booking, not per cart-item quantity.
SECUREVIEW_URGENT_BOOKING_FEE=500
SECUREVIEW_EMERGENCY_BOOKING_FEE=1500
